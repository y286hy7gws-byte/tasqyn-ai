# TASQYN AI — переменные окружения
# Скопируйте в .env.local и заполните нужные значения.
# Приложение полностью работает БЕЗ ключей: в этом случае включается
# локальный DEMO-режим (localStorage) и прозрачный DEMO-анализ AI.

# ---- Supabase (опционально: включает SUPABASE-режим) ----
# Project Settings → API → URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API → anon public key (НЕ service_role!)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- AI-провайдер (опционально: включает реальный мультимодальный анализ) ----
# Достаточно ОДНОГО из ключей. Используются бесплатные тире по вашим лимитам.
# OpenAI (gpt-4o-mini vision)
OPENAI_API_KEY=
# Google AI Studio (gemini-2.5-flash)
GEMINI_API_KEY=

# ---- Административная панель (DEMО-авторизация на клиенте) ----
# Если не задан, используется пароль по умолчанию: tasqyn-admin
NEXT_PUBLIC_ADMIN_PASSWORD=
